# Quiz Arena Backend environment example
# Copy this file to .env for local development and fill in safe development values.
# Do not commit real credentials.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:19006

# Database
MONGODB_URI=mongodb://localhost:27017/quiz-arena

# Auth
JWT_SECRET=replace-with-local-dev-secret
SESSION_SECRET=replace-with-local-dev-secret

# AI
OPENAI_API_KEY=

# Storage
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.local.json

# Realtime
SOCKET_CORS_ORIGIN=http://localhost:19006

# Monitoring
SENTRY_DSN=
